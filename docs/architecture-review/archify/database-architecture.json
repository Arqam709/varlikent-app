  "cards": [
    {
      "dot": "emerald",
      "title": "How to read this",
      "items": [
        "Every arrow is a real ObjectId ref in a Mongoose schema; the label is the field name",
        "The arrow points from the document that stores the id to the document it names",
        "MongoDB does not enforce these: nothing stops a ref pointing at a deleted document"
      ]
    },
    {
      "dot": "amber",
      "title": "Things that are not collections",
      "items": [
        "Favourites are an array on User, not a Favourite collection",
        "There is no Notification collection: the feed is Property.createdAt compared with User.notificationsLastSeenAt",
        "Agent contact fields are also copied onto Property as plain strings"
      ]
    },
    {
      "dot": "violet",
      "title": "User refs not drawn (lines would cross)",
      "items": [
        "PropertyMessage.sender and hiddenFor[]; PropertyConversation.hiddenFromInbox[]",
        "DesignGeneration.user and ServiceRequest.user",
        "ServiceRequest also refs DesignBoard, DesignGeneration and DesignRoomPhoto",
        "OwnerRemovalRequest.confirmedBy and issuances[].requestedBy"
      ]
    },
    {
      "dot": "slate",
      "title": "The 11 standalone collections",
      "items": [
        "Review, Project, Partner, TeamMember, ShowroomImage, AboutContent",
        "PageContent, StudioPalette, SiteSettings, LeadRouting, ContactInterest",
        "LeadRouting and ContactSubmission join on the interestType string, not an ObjectId"
      ]
    }
  ]
