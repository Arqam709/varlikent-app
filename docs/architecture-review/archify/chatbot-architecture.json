  "cards": [
    {
      "dot": "cyan",
      "title": "What Gemini does and does not do",
      "items": [
        "Gemini turns the message into a JSON intent, and turns text into embedding vectors",
        "Gemini never writes the reply and never picks properties",
        "If the key is missing or the call fails, a keyword parser takes over and aiUsed is false"
      ]
    },
    {
      "dot": "emerald",
      "title": "Search order",
      "items": [
        "Plain criteria: structured filter, then relax price and size, then district",
        "Soft wishes such as quiet or sea view: semantic first, then $text, then the structured fallback",
        "A final pass can re-rank by distance to a place using OpenStreetMap"
      ]
    },
    {
      "dot": "amber",
      "title": "Where conversation memory lives",
      "items": [
        "The browser sends currentFilters, the last 10 turns and shown property ids every time",
        "The server is stateless per request; it trusts that state without re-checking it",
        "Signed-in users also get ChatConversation and ChatMessage records; guests get none"
      ]
    },
    {
      "dot": "rose",
      "title": "Risks seen in code",
      "items": [
        "POST /api/chat is public with no rate limit, and each call can spend Gemini quota",
        "Semantic search loads every candidate vector into Node memory",
        "recordChatExchange is repeated nine times in one 833-line handler",
        "Fallback steps 3 and 4 in searchWithFallback build the same query"
      ]
    },
    {
      "dot": "slate",
      "title": "Existing but not on this path",
      "items": [
        "The mobile app has no chatbot screen and never calls /api/chat",
        "Admin listing assistant uses the same Gemini model on /api/admin/property-assistant",
        "Listing vectors are created when an admin saves a property, not at chat time"
      ]
    }
  ]
