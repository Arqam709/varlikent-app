  "cards": [
    {
      "dot": "emerald",
      "title": "How a request travels",
      "items": [
        "cors, express.json and activityLogger run on every request",
        "The router picks a route file; guards run only where a route lists them",
        "The handler lives inside the route file, then calls services or models"
      ]
    },
    {
      "dot": "amber",
      "title": "Layers are not strict",
      "items": [
        "There is no controllers folder and no shared validation layer",
        "Many routes query models directly, for example reviews.js and notifications.js",
        "The guards also read MongoDB: protect loads the User on every request"
      ]
    },
    {
      "dot": "rose",
      "title": "Errors and uploads",
      "items": [
        "Most handlers use try / catch with next(err); auth Google and Microsoft answer errors themselves",
        "Uploads are buffered in RAM by multer, up to 100 MB for video",
        "No rate limiting, helmet or request-size policy beyond express.json defaults"
      ]
    },
    {
      "dot": "cyan",
      "title": "Realtime and background work",
      "items": [
        "Socket.IO shares the HTTP server and accepts no client events",
        "Routes reach it with req.app.get('io') after the database write",
        "The AI image worker and two cleanup sweepers start after listen()"
      ]
    }
  ]
