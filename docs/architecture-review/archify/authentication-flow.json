  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Person and client are untrusted: the web keeps the JWT in localStorage, the app in SecureStore",
        "The only thing the backend trusts is a JWT it signed with JWT_SECRET",
        "ProtectedRoute in the browser is UX; protect() is the real boundary",
        "Socket.IO sends the same JWT in handshake.auth.token and may join only room user:<id>"
      ]
    },
    {
      "dot": "emerald",
      "title": "Who may do what",
      "items": [
        "Roles: owner, admin, agent, user. One role per account",
        "Admins need a named permission per area; owner bypasses permission checks",
        "Agents get /api/agent and their own conversations, never /admin"
      ]
    },
    {
      "dot": "amber",
      "title": "Security concerns found in code",
      "items": [
        "Microsoft login matches accounts by preferred_username, an unverified, tenant-controlled claim",
        "No rate limit on login, register, forgot-password or reset-password",
        "Logout does not revoke the token; a stolen JWT works for up to 7 days",
        "Minimum password length is 6; code reads MICROSOFT_CLIENT_ID but .env.example documents MS_CLIENT_ID"
      ]
    },
    {
      "dot": "cyan",
      "title": "What is done well",
      "items": [
        "Google tokens are checked against an audience allowlist before any lookup",
        "A deactivated account fails on HTTP and on the socket through the same userFromToken",
        "Reset tokens are stored hashed and expire after one hour"
      ]
    }
  ]
