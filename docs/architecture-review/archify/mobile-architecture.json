  "cards": [
    {
      "dot": "cyan",
      "title": "Navigation",
      "items": [
        "Expo Router: files under src/app are the routes; the root is one Stack",
        "Four tabs: Home, Properties, Chats, Account. Everything else pushes on top",
        "There is no central route guard: each screen checks useAuth().status itself"
      ]
    },
    {
      "dot": "emerald",
      "title": "Talking to the backend",
      "items": [
        "Each feature has its own typed API module; all of them go through apiRequest",
        "The token is passed by hand into every call instead of an interceptor",
        "Same /api routes, same JWT and same Socket.IO events as the website"
      ]
    },
    {
      "dot": "rose",
      "title": "Sign-in on the phone",
      "items": [
        "Email and password, or native Google sign-in. No Microsoft sign-in",
        "The app asks Google for an ID token minted for the website's client ID",
        "AuthProvider also calls auth-api for login, register and /auth/me"
      ]
    },
    {
      "dot": "amber",
      "title": "Compared with the website",
      "items": [
        "No AI chatbot, no admin portal and no agent portal in the app",
        "App-only features: Design My Space, room photos, service requests, property alerts",
        "PushProvider also registers the device with POST /api/push/devices"
      ]
    }
  ]
}
