  "cards": [
    {
      "dot": "cyan",
      "title": "Two clients, one backend",
      "items": [
        "Web and mobile call the same /api routes with the same Bearer JWT",
        "The web app opens Socket.IO only for agents; the mobile app for every signed-in user",
        "The AI chatbot is web-only: the mobile app never calls /api/chat"
      ]
    },
    {
      "dot": "emerald",
      "title": "One Node process does everything",
      "items": [
        "REST, Socket.IO and the AI image worker share one process on Render",
        "There is no controllers folder: route files hold the handler logic",
        "REST is the only write path; sockets only push server to client"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Everything above the Render box is untrusted input",
        "Access is decided by protect, requireRole and requirePermission",
        "No rate limiter or helmet is installed anywhere in the backend"
      ]
    },
    {
      "dot": "amber",
      "title": "Left out for readability",
      "items": [
        "OpenStreetMap (Overpass, Nominatim) for chatbot nearby-place answers",
        "MyMemory for CMS and listing auto-translation",
        "Render is inferred from code comments and the mobile default API URL"
      ]
    }
  ]
