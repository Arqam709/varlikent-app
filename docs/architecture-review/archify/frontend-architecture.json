  "cards": [
    {
      "dot": "cyan",
      "title": "How a user moves through the site",
      "items": [
        "Every URL goes through one flat route table in App.jsx",
        "Public pages render inside PublicLayout: navbar, page, footer, chatbot",
        "Guarded pages pass ProtectedRoute, which redirects to /login or /"
      ]
    },
    {
      "dot": "rose",
      "title": "Access boundaries",
      "items": [
        "Roles: user, agent, admin, owner. isAdmin is true for admin and owner",
        "Admin nav links are hidden per permission by hasPermission()",
        "/favourites and /settings pass the same guard with login only, no role",
        "This is UX only: the token and user live in localStorage and can be edited"
      ]
    },
    {
      "dot": "amber",
      "title": "No service layer",
      "items": [
        "43 files call the axios client directly; only messaging has its own API module",
        "No response interceptor: a 401 is handled, or not, by each caller",
        "AuthContext also calls the client for login, register and /auth/me"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "FavouritesContext and SiteSettingsContext follow the same context-to-client pattern",
        "19 source files are imported by nothing, including PropertyContext and AdminLogin",
        "Translations live in one 10,545-line file, locales/translations.js"
      ]
    }
  ]
