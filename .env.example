# Copy to `.env` to override the built-in default.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle in plain text.
# Never put secrets here — the mobile app never needs JWT_SECRET, MONGO_URI,
# or any database / Render / email credentials.

# Deployed Render backend (this is also the fallback baked into
# src/constants/config.ts, so the app runs without a .env at all).
EXPO_PUBLIC_API_URL=https://varli-kent-backend.onrender.com/api

# Local backend over LAN (phone + PC on the same Wi-Fi, firewall allowing Node):
# EXPO_PUBLIC_API_URL=http://192.168.100.200:5000/api

# Google Sign-In — the Varlikent WEB/SERVER OAuth client ID (public identifier).
#
# This must be the SAME client ID the website builds with as VITE_GOOGLE_CLIENT_ID
# and the backend trusts as GOOGLE_CLIENT_ID. Nitro is configured with it as
# `webClientId`, which is what makes Google mint an ID token whose `aud` the
# Varlikent backend already accepts — so no backend allowlist change is needed.
#
# NOT the Android OAuth client ID. That client exists only to bind the package
# name + SHA-1 so Google trusts the installed app; it is never sent to the
# backend and must never appear here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
